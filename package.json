{
  "name": "@vsk/ui-kit-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch=true ",
    "lint": "ng lint",
    "test-headless": "ng test --watch=false --browsers=ChromeHeadless",
    "postinstall": "puppeteer browsers install chrome",
    "storybook": "ng run vsk-ui-kit:storybook --no-open",
    "build-storybook": "ng run vsk-ui-kit:build-storybook"
  },
  "publishConfig": {
    "registry": "https://repo.vsk.ru/repository/npm-hosted/"
  },
  "module": "dist/vsk-ui-kit/fesm2022/vsk-ui-kit.mjs",
  "typings": "dist/vsk-ui-kit/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vsk-ui-kit/index.d.ts",
      "default": "./dist//vsk-ui-kit/fesm2022/vsk-ui-kit.mjs"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.9",
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@compodoc/compodoc": "^1.1.32",
    "@storybook/addon-docs": "^10.0.6",
    "@storybook/addon-onboarding": "^10.0.6",
    "@storybook/angular": "^10.0.6",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.5.1",
    "eslint": "^9.38.0",
    "eslint-plugin-storybook": "^10.0.6",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "puppeteer": "^24.29.1",
    "storybook": "^10.0.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.2"
  }
}
