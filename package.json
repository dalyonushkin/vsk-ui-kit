{
  "name": "@vsk/ui-kit",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build vsk-ui-kit --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch=true ",
    "lint": "ng lint",
    "test-headless": "ng test --watch=false --browsers=ChromeHeadless",
    "postinstall": "puppeteer browsers install chrome",
    "storybook": "ng run vsk-ui-kit:storybook --no-open",
    "build-storybook": "ng run vsk-ui-kit:build-storybook",
    "prepublishOnly": "npm run build:lib",
    "publish:local": "npm publish --registry http://localhost:4873/"
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "files": [
    "dist/vsk-ui-kit/**/*",
    "README.md"
  ],
  "module": "dist/vsk-ui-kit/fesm2022/vsk-ui-kit.mjs",
  "typings": "dist/vsk-ui-kit/index.d.ts",
    "exports": {
    ".": {
      "types": "./dist/vsk-ui-kit/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit.mjs"
    },
    "./tokens": {
      "types": "./dist/vsk-ui-kit/tokens/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-tokens.mjs"
    },
    "./taiga-ui/core": {
      "types": "./dist/vsk-ui-kit/taiga-ui/core/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-core.mjs"
    },
    "./taiga-ui/kit": {
      "types": "./dist/vsk-ui-kit/taiga-ui/kit/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-kit.mjs"
    },
    "./taiga-ui/cdk": {
      "types": "./dist/vsk-ui-kit/taiga-ui/cdk/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-cdk.mjs"
    },
    "./taiga-ui/icons": {
      "types": "./dist/vsk-ui-kit/taiga-ui/icons/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-icons.mjs"
    },
    "./taiga-ui/addon-charts": {
      "types": "./dist/vsk-ui-kit/taiga-ui/addon-charts/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-addon-charts.mjs"
    },
    "./taiga-ui/addon-commerce": {
      "types": "./dist/vsk-ui-kit/taiga-ui/addon-commerce/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-addon-commerce.mjs"
    },
    "./taiga-ui/addon-mobile": {
      "types": "./dist/vsk-ui-kit/taiga-ui/addon-mobile/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-addon-mobile.mjs"
    },
    "./taiga-ui/addon-table": {
      "types": "./dist/vsk-ui-kit/taiga-ui/addon-table/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-addon-table.mjs"
    },
    "./taiga-ui/addon-doc": {
      "types": "./dist/vsk-ui-kit/taiga-ui/addon-doc/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-addon-doc.mjs"
    },
    "./taiga-ui/layout": {
      "types": "./dist/vsk-ui-kit/taiga-ui/layout/index.d.ts",
      "default": "./dist/vsk-ui-kit/fesm2022/vsk-ui-kit-taiga-ui-layout.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@taiga-ui/addon-charts": "4.16.0",
    "@taiga-ui/addon-commerce": "4.16.0",
    "@taiga-ui/addon-doc": "4.16.0",
    "@taiga-ui/addon-mobile": "4.16.0",
    "@taiga-ui/addon-table": "4.16.0",
    "@taiga-ui/cdk": "4.16.0",
    "@taiga-ui/core": "4.16.0",
    "@taiga-ui/event-plugins": "4.7.0",
    "@taiga-ui/i18n": "4.16.0",
    "@taiga-ui/icons": "4.16.0",
    "@taiga-ui/kit": "4.16.0",
    "@taiga-ui/layout": "4.16.0",
    "@taiga-ui/legacy": "4.16.0",
    "@taiga-ui/styles": "4.16.0",
    "@taiga-ui/polymorpheus": "4.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.9",
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@compodoc/compodoc": "^1.1.32",
    "@storybook/addon-a11y": "^10.0.6",
    "@storybook/addon-designs": "^11.0.1",
    "@storybook/addon-docs": "^10.0.6",
    "@storybook/addon-onboarding": "^10.0.6",
    "@storybook/angular": "^10.0.6",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.5.1",
    "eslint": "^9.38.0",
    "eslint-plugin-storybook": "^10.0.6",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "puppeteer": "^24.29.1",
    "storybook": "^10.0.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.2"
  }
}
